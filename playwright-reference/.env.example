# Copie para `.env` (ignorado pelo Git) e preencha com o AMBIENTE ALVO.
# NUNCA comite `.env`, credenciais, tokens ou storage state.

# Ambiente lógico (livre): homolog | prod | ...
APP_ENV=homolog

# --- URLs do ambiente alvo (placeholders — troque pelos reais) ---
BASE_URL=https://app.exemplo.test
BFF_URL=https://api.exemplo.test

# --- Conta de teste do ambiente ---
EAGRO_USER=
EAGRO_PASSWORD=
# OTP fixo, apenas se o ambiente usar código 2FA fixo/bypass. Deixe vazio caso contrário.
EAGRO_OTP=

# --- Autenticação ---
# automated  → login headless (ambientes SEM 2FA, ideal p/ homolog e CI)
# interactive→ login manual uma vez via `npm run auth:login` (2FA)
AUTH_MODE=automated

# --- Execução ---
# HEADED=1   # abre navegador visível (debug local)
