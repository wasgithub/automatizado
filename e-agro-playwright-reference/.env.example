# Copie para `.env` (ignorado pelo Git) e preencha com o AMBIENTE ALVO.
# NUNCA comite `.env`, credenciais, tokens ou storage state.

# Ambiente lógico: homolog | prod. Default = homolog.
# Specs de exemplo baseados em produção só rodam com APP_ENV=prod.
APP_ENV=homolog

# --- URLs do ambiente alvo (ex.: HOMOLOGAÇÃO) ---
BASE_URL=https://<app-homolog>.e-agro.com.br
BFF_URL=https://<bff-homolog>.e-agro.com.br

# --- Conta de teste do ambiente ---
EAGRO_USER=
EAGRO_PASSWORD=
# OTP fixo, apenas se o ambiente usar código 2FA fixo/bypass. Deixe vazio caso contrário.
EAGRO_OTP=

# --- Autenticação ---
# automated  → login headless (ambientes SEM 2FA, ideal p/ homolog e CI)
# interactive→ login manual uma vez via `npm run auth:login` (2FA, ex.: produção)
AUTH_MODE=automated

# --- Execução ---
# HEADED=1   # abre navegador visível (debug local)
