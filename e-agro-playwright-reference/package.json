{
  "name": "e-agro-playwright-reference",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "auth:login": "node scripts/auth-login.cjs",
    "explore": "node scripts/explore-feature.cjs",
    "test:local": "playwright test --project=local",
    "test:functional": "playwright test tests/functional",
    "test:cpr": "playwright test tests/functional/cpr",
    "test:cpr-dollar": "playwright test tests/functional/cpr-dollar",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "HEADED=1 playwright test",
    "test:evidence": "EVIDENCE=1 playwright test",
    "test:debug": "PWDEBUG=1 playwright test",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "trace": "playwright show-trace",
    "typecheck": "tsc --noEmit",
    "check:deps": "node scripts/check-deps.cjs",
    "check:guardrails": "node scripts/check-guardrails.cjs",
    "check": "npm run typecheck && npm run check:deps && npm run check:guardrails"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.9.0"
  }
}
